{
  "arch": "sparc64",
  "data-layout": "E-m:e-i64:64-n32:64-S128",
  "llvm-target": "sparc64-unknown-none-elf",
  "target-endian": "big",
  "target-pointer-width": "64",
  "target-c-int-width": "32",
  "os": "none",
  "env": "",
  "vendor": "unknown",
  "executables": true,
  "linker-flavor": "ld.lld",
  "linker": "rust-lld",
  "panic-strategy": "abort",
  "max-atomic-width": 64,
  "atomic-cas": true,
  "features": "+v9,+vis,+casx"
}
